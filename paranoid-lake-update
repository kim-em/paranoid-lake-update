# diff production


def scan_watchlist(diff_text: str) -> List[dict]:
    hits: List[dict] = []
    current = None
    for line in diff_text.splitlines():
        if line.startswith("+++ "):
            current = line[4:]
            current = current[2:] if current.startswith("b/") else current
            continue
        if not line.startswith("+") or line.startswith("+++"):
            continue
        kinds = [label for label, rx in WATCHLIST_RE if rx.search(line)]
        if kinds:
            hits.append({"file": current, "kind": ", ".join(kinds), "line": line[1:].strip()[:200]})
    return hits


def high_risk(path: str) -> bool:
    return any(rx.search(path) for rx in HIGH_RISK_RE)


def produce_diff(cache: RepoCache, ch: dict, diffs_dir: Path) -> dict:
    """Write diffs/<name>.diff and diffs/<name>.log; return stats."""
    url, old, new, name = ch["url"], ch["old"], ch["new"], ch["name"]
    info: dict = dict(ch)
    info["notes"] = []
    if old and ch.get("old_url") and normalize_url(ch["old_url"]) != normalize_url(url):
        info["notes"].append(f"URL changed from {ch['old_url']} to {url}")
    if new and not cache.ensure_commit(url, new):
        raise RuntimeError(f"{name}: new revision {new} not available from {url}")
    base = old
    if old:
        # The old revision may live on the old URL only (fork switch) or may have
        # been rewritten away upstream; both are worth shouting about.
        if not cache.ensure_commit(url, old):
            info["notes"].append(f"old revision {old} is no longer served by {url}: history rewritten or fork switch; diff is against an empty tree")
            base = None
    if base is None:
        base_ref = EMPTY_TREE
        info["notes"].append("entire tree is new to this workspace" if new else "package removed")
    else:
        base_ref = base
    target = new or EMPTY_TREE
    diff_text = cache.git(url, ["diff", "--no-color", "--no-ext-diff", "--no-textconv", "--find-renames",
                                base_ref, target])
    numstat = cache.git(url, ["diff", "--numstat", "--no-ext-diff", "--no-textconv", "--find-renames", base_ref, target])
    files, ins, dels, binaries = [], 0, 0, []
    for line in numstat.splitlines():
        parts = line.split("\t")
        if len(parts) < 3:
            continue
        a, d, f = parts[0], parts[1], parts[-1]
        files.append(f)
        if a == "-" or d == "-":
            binaries.append(f)
        else:
            ins += int(a)
            dels += int(d)
    non_ff = False
    if base and new:
        log_text = cache.git(url, ["log", "--no-color", "--date=iso-strict",
                                   "--format=%H%n  author:    %an <%ae>%n  committer: %cn <%ce>%n  date:      %ad%n  subject:   %s%n",
                                   f"{base}..{new}"])
        commits = len(re.findall(r"^[0-9a-f]{40}$", log_text, re.M))
        # Commits reachable from old but not new: a reset/force-push upstream.
        lost = cache.git(url, ["rev-list", "--count", f"{new}..{base}"]).strip()
        if lost and lost != "0":
            non_ff = True
            info["notes"].append(f"{lost} commit(s) reachable from the old revision are NOT in the new one (non-fast-forward update); the compare link uses `..` to show the whole tree change")
    else:
        log_text = ""
        commits = None
    stat_text = cache.git(url, ["diff", "--stat=120", "--no-color", "--no-ext-diff", base_ref, target])
    (diffs_dir / f"{name}.diff").write_text(diff_text)
    header = [f"package:   {name}", f"url:       {url}", f"old:       {old or '(none)'}", f"new:       {new or '(removed)'}"]
    if ch.get("inputRev"):
        header.append(f"inputRev:  {ch['inputRev']}")
    header.append(f"inherited: {'yes, via ' + str(ch.get('via')) if ch.get('inherited') else 'no (direct dependency)'}")
    cu = compare_url(url, base, new, two_dot=non_ff) if new else None
    if cu:
        header.append(f"compare:   {cu}")
    for n in info["notes"]:
        header.append(f"NOTE:      {n}")
    (diffs_dir / f"{name}.log").write_text(
        "\n".join(header) + "\n\n== commits (old..new) ==\n" + (log_text or "(not applicable)\n")
        + "\n== diffstat ==\n" + stat_text)
    info.update({
        "commits": commits, "files_changed": len(files), "insertions": ins, "deletions": dels,
        "binary_files": binaries, "high_risk_files": [f for f in files if high_risk(f)],
        "watchlist_hits": scan_watchlist(diff_text), "compare_url": cu, "raw_diff_url": raw_diff_url(cu),
        "raw_patch_url": raw_diff_url(cu, ".patch"), "commit_list": parse_commits(log_text),
        "diff_bytes": len(diff_text.encode()),
    })
    return info


def check_toolchain(manifest_root: Optional[Path], new_entries: Dict[str, dict], cache: RepoCache) -> dict:
    """Report the lean-toolchain each direct dependency wants at its new
    revision.  `lake update` also bumps the root toolchain when the deps agree
    on a newer one; the Mathlib workflow refuses to open a PR in that case."""
    root_tc = None
    if manifest_root and (manifest_root / "lean-toolchain").exists():
        root_tc = (manifest_root / "lean-toolchain").read_text().strip()
    deps = {}
    for name, e in new_entries.items():
        if e.get("skipped") or e.get("inherited"):
            continue
        tc = cache.show_file(e["url"], e["rev"], "lean-toolchain")
        deps[name] = tc.strip() if tc else None
    differs = sorted({t for t in deps.values() if t and root_tc and t != root_tc})
    return {"root": root_tc, "deps": deps, "differs_from_root": differs}


