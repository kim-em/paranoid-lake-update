def _claude_env() -> dict:
    env = dict(os.environ)
    # An API key in the environment makes `claude -p` bill the API even when a
    # subscription login exists.  Prefer the login when one is present; keep the
    # key when it is the only credential (CI).  PARANOID_KEEP_ANTHROPIC_API_KEY=1 forces keeping it.
    creds = Path(os.path.expanduser("~")) / ".claude" / ".credentials.json"
    if env.get("ANTHROPIC_API_KEY") and creds.exists() and not env.get("PARANOID_KEEP_ANTHROPIC_API_KEY"):
        log("ANTHROPIC_API_KEY is set but a Claude login exists; using the login (set PARANOID_KEEP_ANTHROPIC_API_KEY=1 to override)")
        env.pop("ANTHROPIC_API_KEY", None)
    return env


def run_auditor(kind: str, prompt: str, out: Path, args: argparse.Namespace) -> dict:
    extra = shlex.split(args.agent_args) if args.agent_args else []
    model = args.model
    started = now_utc()
    log(f"running auditor {kind}" + (f" ({model})" if model else ""))
    if kind == "claude":
        cmd = ["claude", "-p", "--output-format", "text", "--permission-mode", "dontAsk",
               "--tools", "Read,Grep,Glob", "--allowedTools", "Read,Grep,Glob"]
        if model:
            cmd += ["--model", model]
        cmd += extra
        r = run(cmd, cwd=str(out), input_text=prompt, env=_claude_env(), check=False)
        text = r.stdout
        if r.returncode != 0:
            text += f"\n\n[claude exited with {r.returncode}]\n{r.stderr}"
    elif kind == "codex":
        last = out / ".codex-last-message.txt"
        cmd = ["codex", "exec", "--sandbox", "read-only", "-c", 'approval_policy="never"',
               "--skip-git-repo-check", "-C", str(out), "-o", str(last)]
        if model:
            cmd += ["--model", model]
        cmd += extra + [prompt]
        env = dict(os.environ)
        env["SECOND_OPINION_ACTIVE"] = "1"  # stop Codex bouncing the question to another agent
        with open(os.devnull) as devnull:
            r = subprocess.run(cmd, cwd=str(out), text=True, stdin=devnull, stdout=subprocess.PIPE,
                               stderr=subprocess.STDOUT, env=env, errors="replace")
        text = last.read_text() if last.exists() else r.stdout
        if r.returncode != 0:
            text += f"\n\n[codex exited with {r.returncode}]\n{r.stdout[-4000:]}"
        (out / ".codex-transcript.txt").write_text(r.stdout)
    elif kind == "pi":
        if not model:
            die("--audit pi needs --model (and --pi-provider, default openrouter)")
        session = out / f".pi-session-{stamp()}"
        session.mkdir(exist_ok=True)
        cmd = ["pi", "--provider", args.pi_provider, "--model", model, "--session-dir", str(session)]
        if args.inline:
            cmd += ["--no-tools"]
        cmd += extra + ["--print", prompt]
        r = run(cmd, cwd=str(out), check=False)
        text = r.stdout
        if r.returncode != 0:
            text += f"\n\n[pi exited with {r.returncode}]\n{r.stderr}"
    elif kind == "command":
        if not args.command:
            die("--audit command needs --command 'shell command' (prompt on stdin, cwd = output dir)")
        r = run(["sh", "-c", args.command], cwd=str(out), input_text=prompt, check=False)
        text = r.stdout
        if r.returncode != 0:
            text += f"\n\n[command exited with {r.returncode}]\n{r.stderr}"
    else:
        die(f"unknown auditor {kind}")
    verdicts = re.findall(r"VERDICT:\s*(CLEAN|SUSPICIOUS|MALICIOUS|INCOMPLETE)\b", text)
    verdict = verdicts[-1] if verdicts else None
    label = kind + (f"-{re.sub(r'[^A-Za-z0-9._-]+', '_', model)}" if model else "")
    fname = f"audit-{label}.md"
    header = (f"<!-- auditor: {kind}; model: {model or 'default'}; started: {started}; finished: {now_utc()};"
              f" verdict: {verdict or 'none'} -->\n")
    (out / fname).write_text(header + text.rstrip() + "\n")
    log(f"auditor {kind}: VERDICT {verdict or 'none'} -> {out / fname}")
    return {"auditor": label, "model": model, "verdict": verdict, "file": fname, "started": started, "finished": now_utc()}


def notify(out: Path, plan: dict, status: int, args: argparse.Namespace) -> None:
    cmd = getattr(args, "notify", None)
    if not cmd or status == 0:
        return
    env = dict(os.environ)
    env.update({
        "PLU_OUT": str(out), "PLU_STATUS": str(status), "PLU_TITLE": plan["context"].get("title", ""),
        "PLU_VERDICTS": " ".join(f"{a['auditor']}={a.get('verdict') or 'none'}" for a in plan.get("audits", [])),
    })
    log(f"notify (status {status}): {cmd}")
    r = subprocess.run(["sh", "-c", cmd], cwd=str(out), env=env)
    if r.returncode != 0:
        log(f"warning: notify command exited with {r.returncode}")


def do_audits(out: Path, plan: dict, args: argparse.Namespace) -> int:
    """Run requested auditors; returns exit status (0 clean, 1 flagged, 3 no verdict)."""
    if not args.audit:
        return 0
    if not plan["packages"] and not args.audit_empty:
        log("no dependency changes; skipping audit (use --audit-empty to force)")
        return 0
    prompt = build_prompt(out, load_prompt_template(args.prompt_file), args.prompt_extra, args.inline)
    status = 0
    for kind in args.audit:
        res = run_auditor(kind, prompt, out, args)
        plan["audits"] = [a for a in plan["audits"] if a["auditor"] != res["auditor"]] + [res]
        if res["verdict"] in ("SUSPICIOUS", "MALICIOUS"):
            status = 1
        elif res["verdict"] in (None, "INCOMPLETE") and status == 0:
            status = 3
    write_plan(out, plan)
    write_summary(out, plan)
    notify(out, plan, status, args)
    return status


