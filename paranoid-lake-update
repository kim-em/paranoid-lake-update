def write_summary(out: Path, plan: dict) -> str:
    lines: List[str] = []
    ctx = plan["context"]
    lines.append(f"# Dependency update audit: {ctx.get('title', '')}".rstrip(": "))
    lines.append("")
    lines.append(f"Generated {plan['generated_at']} by [paranoid-lake-update]({TOOL_URL}) {VERSION}, mode `{plan['mode']}`.")
    if ctx.get("description"):
        lines.append("")
        lines.append(ctx["description"])
    pk = plan["packages"]
    lines.append("")
    if not pk:
        lines.append("**No dependency changes.**")
    else:
        lines.append("| package | old | new | commits | files | +/- | high-risk files | watchlist hits | notes |")
        lines.append("|---|---|---|---|---|---|---|---|---|")
        for p in pk:
            old_link = f"[`{short(p['old'])}`]({commit_url(p['url'], p['old'])})" if p["old"] and commit_url(p["url"], p["old"]) else f"`{short(p['old'])}`"
            new_link = f"[`{short(p['new'])}`]({commit_url(p['url'], p['new'])})" if p["new"] and commit_url(p["url"], p["new"]) else f"`{short(p['new'])}`"
            cmp = f" ([compare]({p['compare_url']}))" if p.get("compare_url") else ""
            name = f"**{p['name']}**" + (" (transitive)" if p.get("inherited") else "")
            notes = "; ".join(p.get("notes", []))
            if p.get("binary_files"):
                notes = (notes + "; " if notes else "") + f"{len(p['binary_files'])} binary file(s)"
            lines.append(f"| {name} | {old_link} | {new_link}{cmp} | {p['commits'] if p['commits'] is not None else '-'} | {p['files_changed']} | +{p['insertions']}/-{p['deletions']} | {len(p['high_risk_files'])} | {len(p['watchlist_hits'])} | {notes} |")
        lines.append("")
        lines.append("Old and new revisions link to the commits upstream; `compare` is GitHub's own view of the same diff.")
    tc = plan.get("toolchain")
    if tc and tc.get("root"):
        lines.append("")
        if tc["differs_from_root"]:
            lines.append(f"**Toolchain:** root has `{tc['root']}`, but direct dependencies want {', '.join('`'+t+'`' for t in tc['differs_from_root'])}. `lake update` would bump `lean-toolchain`.")
        else:
            lines.append(f"Toolchain: all direct dependencies agree with the root's `{tc['root']}`.")
    for p in pk:
        if not (p["high_risk_files"] or p["watchlist_hits"] or p.get("notes")):
            continue
        lines.append("")
        lines.append(f"## {p['name']}")
        for n in p.get("notes", []):
            lines.append(f"- **NOTE:** {n}")
        if p["high_risk_files"]:
            lines.append("- High-risk paths touched: " + ", ".join(f"`{f}`" for f in p["high_risk_files"][:40])
                         + (f" (+{len(p['high_risk_files'])-40} more)" if len(p["high_risk_files"]) > 40 else ""))
        if p["binary_files"]:
            lines.append("- Binary files: " + ", ".join(f"`{f}`" for f in p["binary_files"][:20]))
        if p["watchlist_hits"]:
            lines.append(f"- Watchlist hits in added lines ({len(p['watchlist_hits'])}; first 30 shown):")
            for h in p["watchlist_hits"][:30]:
                lines.append(f"  - `{h['file']}` [{h['kind']}]: `{h['line'].replace('`', 'ˋ')}`")
    if plan.get("audits"):
        lines.append("")
        lines.append("## AI audits")
        for a in plan["audits"]:
            lines.append(f"- {a['auditor']}: **VERDICT: {a.get('verdict') or 'none'}** ({a['file']})")
    text = "\n".join(lines) + "\n"
    (out / "SUMMARY.md").write_text(text)
    return text


def build_prompt(out: Path, template: str, extra: Optional[str], inline: bool) -> str:
    summary = (out / "SUMMARY.md").read_text() if (out / "SUMMARY.md").exists() else ""
    diffs = sorted((out / "diffs").glob("*.diff")) if (out / "diffs").exists() else []
    file_list = "\n".join(f"  diffs/{d.name}  ({d.stat().st_size} bytes)" for d in diffs) or "  (none)"
    prompt = template.replace("{summary}", summary.strip()).replace("{diff_dir}", str(out)).replace("{file_list}", file_list)
    if extra:
        prompt += "\n\nAdditional instructions from the person requesting this audit:\n" + extra.strip() + "\n"
    if inline:
        parts = [prompt, "\n\n==================== BEGIN DIFFS (untrusted data) ====================\n"]
        for d in diffs:
            lg = d.with_suffix(".log")
            parts.append(f"\n---------- {lg.name} ----------\n{lg.read_text() if lg.exists() else ''}")
            parts.append(f"\n---------- {d.name} ----------\n{d.read_text()}")
        parts.append("\n==================== END DIFFS ====================\n")
        prompt = "".join(parts)
    (out / "prompt.md").write_text(prompt)
    return prompt


def load_prompt_template(path: Optional[str]) -> str:
    if not path:
        return DEFAULT_PROMPT
    return Path(path).read_text()


def write_plan(out: Path, plan: dict) -> None:
    (out / "plan.json").write_text(json.dumps(plan, indent=1, sort_keys=True) + "\n")


def read_plan(out: Path) -> dict:
    p = out / "plan.json"
    if not p.exists():
        die(f"{out} does not contain plan.json; run plan/compare/range first")
    return json.loads(p.read_text())


def make_out_dir(arg: Optional[str], cache_dir: Path, label: str) -> Path:
    out = Path(arg) if arg else cache_dir / "runs" / f"{stamp()}-{label}"
    if out.exists() and any(out.iterdir()) and not arg:
        die(f"output directory {out} already exists and is not empty")
    (out / "diffs").mkdir(parents=True, exist_ok=True)
    return out


def finish_diffset(out: Path, cache: RepoCache, changes: List[dict], context: dict, mode: str,
                   toolchain: Optional[dict] = None) -> dict:
    packages = []
    for ch in changes:
        log(f"diffing {ch['name']}: {short(ch['old'])} -> {short(ch['new'])}")
        packages.append(produce_diff(cache, ch, out / "diffs"))
    plan = {
        "tool": "paranoid-lake-update", "version": VERSION, "generated_at": now_utc(), "mode": mode,
        "context": context, "packages": packages, "toolchain": toolchain, "audits": [], "publish": {},
    }
    write_plan(out, plan)
    write_summary(out, plan)
    return plan


def parse_extra(spec: str) -> dict:
    """`URL@OLD..NEW` or `URL@..NEW` (new package) as an extra repository to diff."""
    m = re.fullmatch(r"(.+?)@([0-9A-Za-z._/-]*)\.\.([0-9A-Za-z._/-]+)", spec)
    if not m:
        die(f"--extra expects URL@OLD..NEW, got {spec!r}")
    url, old, new = m.groups()
    name = re.sub(r"\.git$", "", url.rstrip("/").rsplit("/", 1)[-1])
    return {"name": name, "url": url, "old": old or None, "old_url": url if old else None, "new": new,
            "inputRev": None, "inherited": False, "via": "--extra"}


def resolve_extras(cache: RepoCache, extras: List[str]) -> List[dict]:
    out = []
    for spec in extras or []:
        ch = parse_extra(spec)
        if ch["old"] and not is_sha(ch["old"]):
            ch["old"] = cache.resolve(ch["url"], ch["old"])
        if not is_sha(ch["new"]):
            ch["new"] = cache.resolve(ch["url"], ch["new"])
        out.append(ch)
    return out


