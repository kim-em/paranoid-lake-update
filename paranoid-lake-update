def add_common(p: argparse.ArgumentParser, out_required: bool = False) -> None:
    p.add_argument("--out", required=out_required, help="output directory (default: a fresh directory under the cache)")
    p.add_argument("--cache-dir", default=str(default_cache_dir()), help="where bare clones live (default: %(default)s)")
    p.add_argument("--offline", action="store_true", help="never fetch; rely on cached clones")


def add_audit_flags(p: argparse.ArgumentParser) -> None:
    g = p.add_argument_group("AI audit")
    g.add_argument("--audit", action="append", choices=["claude", "codex", "pi", "command"], default=[],
                   help="run this auditor (repeatable)")
    g.add_argument("--model", help="model for the auditor (claude/codex/pi)")
    g.add_argument("--pi-provider", default="openrouter", help="provider for --audit pi (default: %(default)s)")
    g.add_argument("--command", help="shell command for --audit command; prompt on stdin, cwd is the output dir")
    g.add_argument("--agent-args", help="extra arguments appended to the agent command line (one shell-quoted string)")
    g.add_argument("--prompt-file", help="prompt template replacing the built-in one ({summary}, {diff_dir}, {file_list} are substituted)")
    g.add_argument("--prompt-extra", help="text appended to the prompt")
    g.add_argument("--inline", action="store_true", help="embed all diffs in the prompt instead of relying on the agent's file tools")
    g.add_argument("--audit-empty", action="store_true", help="run the auditor even when nothing changed")
    g.add_argument("--notify", metavar="CMD", help="shell command run when an audit is not CLEAN (or gave no verdict); "
                   "PLU_OUT, PLU_STATUS, PLU_TITLE, PLU_VERDICTS are set in its environment")


def add_publish_flags(p: argparse.ArgumentParser) -> None:
    g = p.add_argument_group("publishing (needs gh)")
    g.add_argument("--gist", action="store_true", help="upload summary, prompt, diffs and audits as a secret gist")
    g.add_argument("--gist-public", action="store_true", help="make the gist public rather than secret")
    g.add_argument("--comment-pr", metavar="N", help="post the summary (and gist/audit links) as a comment on this PR")
    g.add_argument("--github-repo", metavar="OWNER/REPO", help="repository of --comment-pr (default: gh's current repo)")
    g.add_argument("--run-url", help="workflow run URL to link from the comment (artifact with the diffs)")
    g.add_argument("--dry-run", action="store_true", help="write comment.md but do not create a gist or post")


def context_for(dir_: Path, mode: str, title: str, repro: str, description: str = "") -> dict:
    return {"title": title, "root": str(dir_.resolve()), "repro": repro, "description": description, "mode": mode}


def cmd_plan(args: argparse.Namespace) -> int:
    root = Path(args.dir).resolve()
    mpath = Path(args.manifest) if args.manifest else root / "lake-manifest.json"
    if not mpath.exists():
        die(f"no manifest at {mpath}")
    cache = RepoCache(Path(args.cache_dir), args.offline)
    old = read_manifest_file(mpath)
    log(f"predicting `lake update` for {root} ({len(git_packages(old))} git packages)")
    new = predict_update(old, cache)
    changes = changes_between(old, new) + resolve_extras(cache, args.extra)
    toolchain = check_toolchain(root, new, cache)
    out = make_out_dir(args.out, Path(args.cache_dir), "plan-" + root.name)
    ctx = context_for(root, "plan", f"`lake update` in {root.name}",
                      f"paranoid-lake-update plan --audit claude   # in {root}",
                      "Predicted from the manifest and upstream branch heads; nothing from upstream was executed.")
    plan = finish_diffset(out, cache, changes, ctx, "plan", toolchain)
    return finish(out, plan, args)


def cmd_compare(args: argparse.Namespace) -> int:
    root = Path(args.dir).resolve()
    cache = RepoCache(Path(args.cache_dir), args.offline)
    if args.old_manifest:
        old = read_manifest_file(Path(args.old_manifest))
        old_desc = args.old_manifest
    elif args.base:
        old = manifest_at_ref(root, args.base, args.manifest_name)
        old_desc = f"{args.base}:{args.manifest_name}"
    else:
        die("compare needs --base REF or --old-manifest FILE")
    if args.new_manifest:
        new_m = read_manifest_file(Path(args.new_manifest))
        new_desc = args.new_manifest
    elif args.head:
        new_m = manifest_at_ref(root, args.head, args.manifest_name)
        new_desc = f"{args.head}:{args.manifest_name}"
    else:
        new_m = read_manifest_file(root / args.manifest_name)
        new_desc = f"working tree {args.manifest_name}"
    log(f"comparing {old_desc} -> {new_desc}")
    changes = changes_between(old, entries_from_manifest(new_m)) + resolve_extras(cache, args.extra)
    out = make_out_dir(args.out, Path(args.cache_dir), "compare-" + root.name)
    title = args.title or f"{root.name}: {old_desc} -> {new_desc}"
    ctx = context_for(root, "compare", title,
                      f"paranoid-lake-update compare --base {args.base or 'origin/master'} --audit claude   # in a checkout of the PR branch")
    plan = finish_diffset(out, cache, changes, ctx, "compare", None)
    return finish(out, plan, args)


def cmd_range(args: argparse.Namespace) -> int:
    cache = RepoCache(Path(args.cache_dir), args.offline)
    url = args.repo
    if os.path.isdir(url):
        url = str(Path(url).resolve())
    name = args.name or re.sub(r"\.git$", "", normalize_url(url).rsplit("/", 1)[-1])
    old = cache.resolve(url, args.from_rev) if args.from_rev else None
    new = cache.resolve(url, args.to_rev)
    ch = {"name": name, "url": url, "old": old, "old_url": url if old else None, "new": new,
          "inputRev": args.to_rev, "inherited": False, "via": "range"}
    out = make_out_dir(args.out, Path(args.cache_dir), "range-" + name)
    ctx = context_for(Path.cwd(), "range", f"{name} {short(old)}..{short(new)}",
                      f"paranoid-lake-update range --repo {url} --from {old or ''} --to {new} --audit claude")
    ctx["description"] = f"Changes in `{url}` between `{args.from_rev or '(empty tree)'}` and `{args.to_rev}`."
    plan = finish_diffset(out, cache, [ch] + resolve_extras(cache, args.extra), ctx, "range", None)
    return finish(out, plan, args)


def cmd_watch(args: argparse.Namespace) -> int:
    cache = RepoCache(Path(args.cache_dir), args.offline)
    url = args.repo
    if os.path.isdir(url):
        url = str(Path(url).resolve())
    name = args.name or re.sub(r"\.git$", "", normalize_url(url).rsplit("/", 1)[-1])
    state_path = Path(args.state) if args.state else Path(args.cache_dir) / "watch" / f"{name}-{hashlib.sha1(url.encode()).hexdigest()[:8]}.json"
    state = json.loads(state_path.read_text()) if state_path.exists() else {}
    head = cache.resolve(url, args.branch)
    last = args.from_rev or state.get("rev")
    if last and not is_sha(last):
        last = cache.resolve(url, last)
    if not last:
        state_path.parent.mkdir(parents=True, exist_ok=True)
        state_path.write_text(json.dumps({"url": url, "branch": args.branch, "rev": head, "updated": now_utc()}, indent=1) + "\n")
        log(f"initialized {state_path} at {short(head)}; nothing audited (pass --from REV to audit a range now)")
        return 0
    if last == head:
        log(f"{name}/{args.branch} still at {short(head)}; nothing to do")
        return 0
    ch = {"name": name, "url": url, "old": last, "old_url": url, "new": head, "inputRev": args.branch,
          "inherited": False, "via": "watch"}
    out = make_out_dir(args.out, Path(args.cache_dir), f"watch-{name}")
    ctx = context_for(Path.cwd(), "watch", f"{name}/{args.branch} {short(last)}..{short(head)}",
                      f"paranoid-lake-update range --repo {url} --from {last} --to {head} --audit claude")
    ctx["description"] = f"New commits on `{args.branch}` of `{url}` since the last audit."
    plan = finish_diffset(out, cache, [ch], ctx, "watch", None)
    status = finish(out, plan, args)
    if status in (0, 1) or args.advance_always:
        # Advance only when the audit actually ran (or none was asked for); a
        # missing verdict (status 3) or crash leaves the state so the next run retries.
        state_path.parent.mkdir(parents=True, exist_ok=True)
        state_path.write_text(json.dumps({"url": url, "branch": args.branch, "rev": head, "updated": now_utc(),
                                          "last_out": str(out), "last_status": status}, indent=1) + "\n")
    return status


def cmd_audit(args: argparse.Namespace) -> int:
    out = Path(args.out)
    plan = read_plan(out)
    if not args.audit:
        args.audit = ["claude"]
    status = do_audits(out, plan, args)
    do_publish(out, plan, args)
    print(out)
    return status


def cmd_publish(args: argparse.Namespace) -> int:
    out = Path(args.out)
    plan = read_plan(out)
    do_publish(out, plan, args)
    print(out)
    return 0


def cmd_prompt(args: argparse.Namespace) -> int:
    out = Path(args.out)
    read_plan(out)
    print(build_prompt(out, load_prompt_template(args.prompt_file), args.prompt_extra, args.inline), end="")
    return 0


def finish(out: Path, plan: dict, args: argparse.Namespace) -> int:
    status = do_audits(out, plan, args)
    do_publish(out, plan, args)
    if getattr(args, "print_summary", True):
        sys.stdout.write((out / "SUMMARY.md").read_text())
    print(f"\noutput: {out}")
    if getattr(args, "fail_on_change", False) and plan["packages"]:
        return max(status, 1)
    return status


def main(argv: Optional[List[str]] = None) -> int:
    ap = argparse.ArgumentParser(prog="paranoid-lake-update", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--version", action="version", version=VERSION)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("plan", help="predict what `lake update` would do, without running it")
    p.add_argument("--dir", default=".", help="package directory (default: .)")
    p.add_argument("--manifest", help="manifest file (default: <dir>/lake-manifest.json)")
    p.add_argument("--extra", action="append", default=[], metavar="URL@OLD..NEW", help="also diff this repository (repeatable)")
    p.add_argument("--fail-on-change", action="store_true", help="exit 1 if any dependency would change")
    add_common(p); add_audit_flags(p); add_publish_flags(p)
    p.set_defaults(func=cmd_plan)

    p = sub.add_parser("compare", help="diff dependency changes between two manifests or refs")
    p.add_argument("--dir", default=".", help="package directory (default: .)")
    p.add_argument("--base", metavar="REF", help="git ref holding the old manifest (e.g. origin/master)")
    p.add_argument("--head", metavar="REF", help="git ref holding the new manifest (default: working tree)")
    p.add_argument("--old-manifest", metavar="FILE", help="old manifest file instead of --base")
    p.add_argument("--new-manifest", metavar="FILE", help="new manifest file instead of the working tree")
    p.add_argument("--manifest-name", default="lake-manifest.json", help=argparse.SUPPRESS)
    p.add_argument("--title", help="title for the summary and comment")
    p.add_argument("--extra", action="append", default=[], metavar="URL@OLD..NEW", help="also diff this repository (repeatable)")
    add_common(p); add_audit_flags(p); add_publish_flags(p)
    p.set_defaults(func=cmd_compare)

    p = sub.add_parser("range", help="diff one repository between two revisions")
    p.add_argument("--repo", required=True, help="git URL or local path")
    p.add_argument("--from", dest="from_rev", metavar="REV", help="old revision (omit for the empty tree)")
    p.add_argument("--to", dest="to_rev", metavar="REV", required=True, help="new revision, branch or tag")
    p.add_argument("--name", help="package name to use in the output (default: from the URL)")
    p.add_argument("--extra", action="append", default=[], metavar="URL@OLD..NEW", help="also diff this repository (repeatable)")
    add_common(p); add_audit_flags(p); add_publish_flags(p)
    p.set_defaults(func=cmd_range)

    p = sub.add_parser("watch", help="audit new commits on a branch since the last run")
    p.add_argument("--repo", required=True, help="git URL or local path")
    p.add_argument("--branch", default="main", help="branch to follow (default: %(default)s)")
    p.add_argument("--state", metavar="FILE", help="state file remembering the last audited revision (default: under the cache)")
    p.add_argument("--from", dest="from_rev", metavar="REV", help="override the recorded starting revision")
    p.add_argument("--name", help="package name to use in the output")
    p.add_argument("--advance-always", action="store_true", help="record the new head even if the audit gave no verdict")
    add_common(p); add_audit_flags(p); add_publish_flags(p)
    p.set_defaults(func=cmd_watch)

    p = sub.add_parser("audit", help="run an AI auditor on an existing output directory")
    add_common(p, out_required=True); add_audit_flags(p); add_publish_flags(p)
    p.set_defaults(func=cmd_audit)

    p = sub.add_parser("publish", help="gist / PR comment for an existing output directory")
    add_common(p, out_required=True); add_publish_flags(p)
    p.set_defaults(func=cmd_publish)

    p = sub.add_parser("prompt", help="print the audit prompt for an existing output directory")
    add_common(p, out_required=True)
    p.add_argument("--prompt-file"); p.add_argument("--prompt-extra"); p.add_argument("--inline", action="store_true")
    p.set_defaults(func=cmd_prompt)

    args = ap.parse_args(argv)
    try:
        return args.func(args)
    except RuntimeError as e:
        die(str(e))
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
