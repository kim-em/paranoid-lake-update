# ----------------------------------------------------------------------------
# small utilities


def log(msg: str) -> None:
    print(f"paranoid-lake-update: {msg}", file=sys.stderr, flush=True)


def die(msg: str, code: int = 2) -> "NoReturn":  # type: ignore[name-defined]
    log(f"error: {msg}")
    sys.exit(code)


def run(cmd: List[str], cwd: Optional[str] = None, check: bool = True,
        input_text: Optional[str] = None, env: Optional[dict] = None,
        capture: bool = True) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(
            cmd, cwd=cwd, check=check, text=True, input=input_text, env=env,
            stdout=subprocess.PIPE if capture else None,
            stderr=subprocess.PIPE if capture else None,
            errors="replace")
    except subprocess.CalledProcessError as e:
        err = (e.stderr or "").strip()
        raise RuntimeError(f"command failed ({e.returncode}): {shlex.join(cmd)}\n{err}") from None
    except FileNotFoundError:
        raise RuntimeError(f"command not found: {cmd[0]}") from None


def git(args: List[str], cwd: Optional[str] = None, check: bool = True) -> str:
    env = dict(os.environ)
    env.setdefault("GIT_TERMINAL_PROMPT", "0")
    return run(["git"] + args, cwd=cwd, check=check, env=env).stdout


def now_utc() -> str:
    return _dt.datetime.now(_dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def stamp() -> str:
    return _dt.datetime.now(_dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def is_sha(rev: str) -> bool:
    return bool(re.fullmatch(r"[0-9a-f]{40}", rev or ""))


def short(rev: Optional[str]) -> str:
    return rev[:10] if rev else "-"


def default_cache_dir() -> Path:
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache")
    return Path(base) / "paranoid-lake-update"


def normalize_url(url: str) -> str:
    url = url.strip()
    if url.endswith("/"):
        url = url[:-1]
    if url.endswith(".git"):
        url = url[:-4]
    return url


def web_url(url: str) -> Optional[str]:
    """Best-effort https browse URL for a git remote."""
    u = normalize_url(url)
    m = re.match(r"^(?:git@|ssh://git@)([^:/]+)[:/](.+)$", u)
    if m:
        return f"https://{m.group(1)}/{m.group(2)}"
    if u.startswith("http://") or u.startswith("https://"):
        return u
    return None


def compare_url(url: str, old: Optional[str], new: Optional[str], two_dot: bool = False) -> Optional[str]:
    """GitHub/GitLab compare view.  `old...new` (three dots) shows the changes
    since the merge base, which for a fast-forward update is exactly the diff;
    when the update is not a fast-forward, `old..new` (two dots) shows the full
    change to the tree instead."""
    w = web_url(url)
    if not w:
        return None
    dots = ".." if two_dot else "..."
    if "gitlab" in w:
        if old and new:
            return f"{w}/-/compare/{old}{dots}{new}"
        return f"{w}/-/tree/{new}" if new else None
    if old and new:
        return f"{w}/compare/{old}{dots}{new}"
    if new:
        return f"{w}/tree/{new}"
    return None


def raw_diff_url(cu: Optional[str], suffix: str = ".diff") -> Optional[str]:
    """GitHub serves the unified diff of a compare view at the same URL + `.diff`,
    and the per-commit patches (with authorship) at `.patch`."""
    if cu and "github.com" in cu and "/compare/" in cu:
        return cu + suffix
    return None


def parse_commits(log_text: str) -> List[dict]:
    out: List[dict] = []
    cur: Optional[dict] = None
    for line in log_text.splitlines():
        if re.fullmatch(r"[0-9a-f]{40}", line):
            cur = {"sha": line}
            out.append(cur)
        elif cur is not None:
            m = re.match(r"\s+(author|committer|date|subject):\s+(.*)$", line)
            if m:
                cur[m.group(1)] = m.group(2)
    return out


def commit_url(url: str, rev: str) -> Optional[str]:
    w = web_url(url)
    return f"{w}/commit/{rev}" if w else None


# ----------------------------------------------------------------------------
# bare repository cache


class RepoCache:
    """Bare clones of upstream repositories.  Nothing is ever checked out, so no
    hooks, filters, or build files from the upstream can run."""

    def __init__(self, cache_dir: Path, offline: bool = False):
        self.dir = cache_dir / "repos"
        self.dir.mkdir(parents=True, exist_ok=True)
        self.offline = offline
        self._fetched: Dict[str, bool] = {}

    def path(self, url: str) -> Path:
        key = normalize_url(url)
        base = re.sub(r"[^A-Za-z0-9._-]+", "-", key.rsplit("/", 1)[-1]) or "repo"
        return self.dir / f"{base}-{hashlib.sha1(key.encode()).hexdigest()[:12]}.git"

    def open(self, url: str) -> Path:
        p = self.path(url)
        if not p.exists():
            if self.offline:
                raise RuntimeError(f"offline and no cached clone of {url}")
            log(f"cloning {url} (bare)")
            git(["clone", "--bare", "--quiet", "--", url, str(p)])
            # Bare clones only get a HEAD refspec by default; track everything.
            git(["config", "remote.origin.fetch", "+refs/heads/*:refs/heads/*"], cwd=str(p))
            git(["config", "remote.origin.url", url], cwd=str(p))
            self._fetched[str(p)] = False
        self.fetch(url)
        return p

    def fetch(self, url: str) -> None:
        p = self.path(url)
        if self.offline or self._fetched.get(str(p)):
            return
        log(f"fetching {url}")
        git(["fetch", "--quiet", "--prune", "--tags", "--force", "origin",
             "+refs/heads/*:refs/heads/*"], cwd=str(p))
        self._fetched[str(p)] = True

    def has_commit(self, url: str, rev: str) -> bool:
        p = self.open(url)
        r = run(["git", "cat-file", "-e", f"{rev}^{{commit}}"], cwd=str(p), check=False)
        return r.returncode == 0

    def ensure_commit(self, url: str, rev: str) -> bool:
        """Make sure `rev` is present, fetching it by hash if needed.  Returns
        False when the remote no longer serves that commit."""
        if self.has_commit(url, rev):
            return True
        if self.offline:
            return False
        p = self.path(url)
        r = run(["git", "fetch", "--quiet", "origin", rev], cwd=str(p), check=False)
        return r.returncode == 0 and self.has_commit(url, rev)

    def resolve(self, url: str, input_rev: Optional[str]) -> str:
        """Mirror Lake's `resolveRemoteRevision`: full SHAs stand; otherwise a
        branch (`origin/<rev>` in a checkout, `refs/heads/<rev>` here), then a
        tag, then anything `rev-parse` accepts."""
        rev = input_rev or "master"
        if is_sha(rev):
            self.ensure_commit(url, rev)
            return rev
        p = self.open(url)
        for candidate in (f"refs/heads/{rev}", f"refs/tags/{rev}", rev):
            r = run(["git", "rev-parse", "--verify", "--quiet", "--end-of-options",
                     f"{candidate}^{{commit}}"], cwd=str(p), check=False)
            if r.returncode == 0 and r.stdout.strip():
                return r.stdout.strip()
        raise RuntimeError(f"{url}: revision not found '{rev}'")

    def show_file(self, url: str, rev: str, path: str) -> Optional[str]:
        p = self.open(url)
        r = run(["git", "show", f"{rev}:{path}"], cwd=str(p), check=False)
        return r.stdout if r.returncode == 0 else None

    def git(self, url: str, args: List[str]) -> str:
        return git(args, cwd=str(self.open(url)))


