# manifests and update prediction


def parse_manifest(text: str, where: str) -> dict:
    try:
        m = json.loads(text)
    except json.JSONDecodeError as e:
        raise RuntimeError(f"{where}: not valid JSON: {e}")
    if not isinstance(m.get("packages"), list):
        raise RuntimeError(f"{where}: no 'packages' array (manifest version {m.get('version')!r})")
    return m


def read_manifest_file(path: Path) -> dict:
    return parse_manifest(path.read_text(), str(path))


def manifest_at_ref(repo_dir: Path, ref: str, name: str = "lake-manifest.json") -> dict:
    text = git(["show", f"{ref}:{name}"], cwd=str(repo_dir))
    return parse_manifest(text, f"{ref}:{name}")


def git_packages(manifest: dict) -> List[dict]:
    return [p for p in manifest["packages"] if p.get("type") == "git"]


def predict_update(manifest: dict, cache: RepoCache) -> Dict[str, dict]:
    """Predict the result of a bare `lake update`.

    Lake (Lake/Load/Resolve.lean, `updateAndMaterializeCore`) materializes each
    direct dependency at the head of its `inputRev`, visiting the root's
    requires in reverse order, which is the order they are written in the
    manifest.  After each package is materialized, the entries of *its*
    manifest are recorded (marked inherited) for every name not yet seen, and
    transitive dependencies are then materialized at those recorded revisions.
    Names seen first win.  We replay exactly that, using bare clones instead of
    checkouts, and never load a lakefile."""
    resolved: Dict[str, dict] = {}
    queue: List[str] = []
    for p in manifest["packages"]:
        if p.get("inherited"):
            continue
        if p.get("type") != "git":
            resolved[p["name"]] = {"name": p["name"], "type": p.get("type"), "skipped": True}
            continue
        new = cache.resolve(p["url"], p.get("inputRev"))
        resolved[p["name"]] = {
            "name": p["name"], "url": p["url"], "rev": new, "inputRev": p.get("inputRev"),
            "inherited": False, "via": "<root>", "manifestFile": p.get("manifestFile") or "lake-manifest.json",
        }
        queue.append(p["name"])
    while queue:
        name = queue.pop(0)
        e = resolved[name]
        text = cache.show_file(e["url"], e["rev"], e["manifestFile"])
        if text is None:
            continue
        try:
            sub = parse_manifest(text, f"{name}@{short(e['rev'])}:{e['manifestFile']}")
        except RuntimeError as err:
            log(f"warning: {err}")
            continue
        for q in sub["packages"]:
            if q["name"] in resolved:
                continue
            if q.get("type") != "git":
                resolved[q["name"]] = {"name": q["name"], "type": q.get("type"), "skipped": True, "via": name}
                continue
            resolved[q["name"]] = {
                "name": q["name"], "url": q["url"], "rev": q["rev"], "inputRev": q.get("inputRev"),
                "inherited": True, "via": name, "manifestFile": q.get("manifestFile") or "lake-manifest.json",
            }
            queue.append(q["name"])
    return resolved


def changes_between(old: dict, new: Dict[str, dict]) -> List[dict]:
    """List package changes between an old manifest and a predicted/new set of
    entries (dict name -> entry with url/rev)."""
    old_by = {p["name"]: p for p in old["packages"]}
    out: List[dict] = []
    for name, e in new.items():
        if e.get("skipped"):
            continue
        o = old_by.get(name)
        if o is not None and o.get("type") == "git" and o["rev"] == e["rev"] and normalize_url(o["url"]) == normalize_url(e["url"]):
            continue
        out.append({
            "name": name, "url": e["url"],
            "old": o["rev"] if o and o.get("type") == "git" else None,
            "old_url": o["url"] if o and o.get("type") == "git" else None,
            "new": e["rev"], "inputRev": e.get("inputRev"),
            "inherited": bool(e.get("inherited")), "via": e.get("via"),
        })
    for name, o in old_by.items():
        if name not in new and o.get("type") == "git":
            out.append({"name": name, "url": o["url"], "old": o["rev"], "old_url": o["url"],
                        "new": None, "inputRev": o.get("inputRev"), "inherited": bool(o.get("inherited")), "via": None})
    return out


def entries_from_manifest(m: dict) -> Dict[str, dict]:
    out: Dict[str, dict] = {}
    for p in m["packages"]:
        if p.get("type") != "git":
            out[p["name"]] = {"name": p["name"], "skipped": True}
            continue
        out[p["name"]] = {"name": p["name"], "url": p["url"], "rev": p["rev"], "inputRev": p.get("inputRev"),
                          "inherited": bool(p.get("inherited")), "via": None}
    return out


